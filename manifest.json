{
  "manifest_version": 3,
  "name": "ConvoPort",
  "version": "0.1.0",
  "description": "Snapshot a Claude.ai conversation and continue it in ChatGPT, Gemini, or DeepSeek.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ConvoPort",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["lib/destinations.js", "lib/markdown.js", "content/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["content/destination.js"],
      "run_at": "document_idle"
    }
  ]
}
